{
  "name": "@openlantern-ai/proxy",
  "version": "0.3.6",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --dts",
    "test": "vitest run",
    "dev": "tsup src/index.ts src/cli.ts --format esm --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openlantern-ai/sdk": "workspace:*",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@freelancer/shared-utils": "file:../../shared-packages/shared-utils",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
